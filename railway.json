{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "providers": ["python", "node"],
      "variables": {
        "NIXPACKS_NODE_VERSION": "22"
      }
    },
    "buildCommand": "pip install -r requirements.txt && cd conecta-campus-frontend && rm -rf node_modules package-lock.json && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE"
  }
}